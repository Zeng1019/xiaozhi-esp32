{
  "manufacturer": "claw",
  "type": "esp-claw",
  "target": "esp32s3",
  "builds": [
    {
      "name": "esp-claw",
      "sdkconfig_append": [
        "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
        "CONFIG_SPIRAM=y",
        "CONFIG_SPIRAM_MODE_OCT=y",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=y"
      ]
    }
  ]
}
